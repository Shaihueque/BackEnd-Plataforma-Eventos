# Entorno de pruebas
NODE_ENV=test

# Puerto utilizado en pruebas de integración
PORT=3001

# Base de datos exclusiva para pruebas
MONGO_URL=mongodb+srv://USUARIO:CONTRASENA@CLUSTER.mongodb.net/akun_eventos_test

# Clave de ejemplo para pruebas (no utilizar en producción)
JWT_SECRET=clave_de_pruebas_reemplazar

# Duración del token JWT
JWT_EXPIRES_IN=1h